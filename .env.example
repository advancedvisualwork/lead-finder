# Copy to .env.local (local) or set in Vercel > Project > Settings > Environment Variables.

# Optional: when set, Google Places (New) is used instead of OpenStreetMap.
GOOGLE_PLACES_API_KEY=

# Nominatim usage policy asks for an identifying User-Agent (app name + contact).
NOMINATIM_USER_AGENT=lead-finder/1.0

# Optional: comma-separated Overpass mirrors (https only), tried in order.
OVERPASS_URLS=
